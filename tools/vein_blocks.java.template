package xiuxian.block;

import java.util.LinkedHashMap;
import java.util.Map;
import net.minecraft.world.item.*;
import net.minecraft.world.item.crafting.RecipeType;
import net.minecraft.world.level.block.*;
import net.minecraft.world.level.block.entity.BlockEntityType;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraftforge.event.BuildCreativeModeTabContentsEvent;
import net.minecraftforge.eventbus.api.IEventBus;
import net.minecraftforge.registries.*;
import xiuxian.vein.*;

/** Generated by tools/vein_assets.py; interaction implementations are maintained separately. */
public final class VeinBlocks {
    public enum Kind { ROCK, ORE, CLUSTER, CUBE, BRACE, RAIL, SLAB, CHAIN, GRATE, PILLAR, CRAFT, CAGE, SWITCH, LAMP, CACHE, GATE, SENSOR, STATION, SEAT }
    private static final DeferredRegister<Block> BLOCKS = DeferredRegister.create(ForgeRegistries.BLOCKS, "xiuxian");
    private static final DeferredRegister<Item> ITEMS = DeferredRegister.create(ForgeRegistries.ITEMS, "xiuxian");
    private static final DeferredRegister<BlockEntityType<?>> ENTITIES = DeferredRegister.create(ForgeRegistries.BLOCK_ENTITY_TYPES, "xiuxian");
    private static final Map<String, RegistryObject<Block>> RESOURCES = new LinkedHashMap<>();
    private static final Map<String, RegistryObject<Item>> MATERIALS = new LinkedHashMap<>();
    static {
// CATALOG
// MATERIALS
    }
    public static final RegistryObject<BlockEntityType<VeinStationBlockEntity>> STATION_ENTITY = ENTITIES.register("vein_station",
            () -> BlockEntityType.Builder.of(VeinStationBlockEntity::new, RESOURCES.values().stream().map(RegistryObject::get)
                    .filter(b -> b instanceof VeinStationBlock).toArray(Block[]::new)).build(null));

    private static void add(String id, Kind kind, int layer, double[][] boxes) {
        var block = BLOCKS.register(id, () -> {
            var p = Block.Properties.of().strength(kind == Kind.ORE ? 3.5F + layer * .25F : 2.5F, 6).sound(SoundType.STONE);
            if (kind == Kind.ORE) p.requiresCorrectToolForDrops();
            return switch (kind) {
                case ROCK, CUBE -> new Block(p);
                case ORE -> new DropExperienceBlock(p, net.minecraft.util.valueproviders.UniformInt.of(1, layer + 1));
                case SLAB -> new SlabBlock(p);
                case LAMP -> new SectLampBlock(p, boxes);
                case SEAT -> new SectSeatBlock(p, boxes, .62);
                case CLUSTER -> new VeinClusterBlock(p.randomTicks(), boxes, layer);
                case STATION, CACHE -> new VeinStationBlock(p, boxes, id, kind == Kind.CACHE);
                case GATE -> new VeinSealBlock(p, boxes, id);
                case SWITCH -> new VeinSwitchBlock(p, boxes);
                case SENSOR -> new VeinSensorBlock(p, boxes, id.endsWith("arena_sensor"));
                case CRAFT -> new VeinCraftingBlock(p, boxes);
                default -> new OrientalDecorationBlock(p, boxes);
            };
        });
        RESOURCES.put(id, block);
        ITEMS.register(id, () -> new BlockItem(block.get(), new Item.Properties()));
    }
    private static void material(String id, String kind) {
        MATERIALS.put(id, ITEMS.register(id, () -> switch (kind) {
            case "fuel" -> new Item(new Item.Properties()) {
                @Override public int getBurnTime(ItemStack stack, RecipeType<?> type) { return 3200; }
            };
            case "drink" -> new VeinTonicItem(id);
            default -> new Item(new Item.Properties());
        }));
    }
    public static BlockState state(String id) { return RESOURCES.get(id).get().defaultBlockState(); }
    public static Item material(String id) { return MATERIALS.get(id).get(); }
    public static Map<String, RegistryObject<Block>> resources() { return Map.copyOf(RESOURCES); }
    public static Map<String, RegistryObject<Item>> materials() { return Map.copyOf(MATERIALS); }
    public static void register(IEventBus bus) {
        BLOCKS.register(bus); ITEMS.register(bus); ENTITIES.register(bus);
        bus.addListener(VeinBlocks::creative);
    }
    private static void creative(BuildCreativeModeTabContentsEvent event) {
        if (event.getTabKey() == CreativeModeTabs.BUILDING_BLOCKS) RESOURCES.values().forEach(b -> event.accept(b.get()));
        if (event.getTabKey() == CreativeModeTabs.INGREDIENTS) MATERIALS.values().forEach(i -> event.accept(i.get()));
        if (event.getTabKey() == CreativeModeTabs.FUNCTIONAL_BLOCKS) RESOURCES.values().forEach(b -> {
            if (b.get() instanceof VeinStationBlock || b.get() instanceof VeinSealBlock || b.get() instanceof VeinSensorBlock
                    || b.get() instanceof SectSeatBlock || b.get() instanceof SectLampBlock || b.get() instanceof VeinSwitchBlock
                    || b.get() instanceof VeinCraftingBlock) event.accept(b.get());
        });
    }
}
